Use full prototypes for close_display() and wire_to_event()

The forward declarations were unprototyped (`static int close_display();`).
In C23, empty parentheses mean (void), so assigning them to the
XExtensionHooks function pointers fails with
-Wincompatible-function-pointer-types.

diff --git a/src/NVCtrl.c b/src/NVCtrl.c
index e984373947..30f640ad80 100644
--- a/src/NVCtrl.c
+++ b/src/NVCtrl.c
@@ -56,9 +56,9 @@ static const char *nvctrl_extension_name = NV_CONTROL_NAME;
 #define XNVCTRLSimpleCheckExtension(dpy,i) \
   XextSimpleCheckExtension (dpy, i, nvctrl_extension_name)
 
-static int close_display();
+static int close_display(Display *dpy, XExtCodes *codes);
 static uintptr_t version_flags(Display *dpy, XExtDisplayInfo *info);
-static Bool wire_to_event();
+static Bool wire_to_event(Display *dpy, XEvent *host, xEvent *wire);
 static /* const */ XExtensionHooks nvctrl_extension_hooks = {
     NULL,                               /* create_gc */
     NULL,                               /* copy_gc */
