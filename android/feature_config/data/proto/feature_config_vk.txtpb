    {
        package_name: "com.wonder.wdgg.mi"
        feature_configs:
        [ { feature_name: "initializeColorAttachmentWithWhite" enabled: true }]
    },

    # Kingdom Legend (b/519685593#comment10)
    {
        package_name: "com.shenghe.wzcq.huawei"
        feature_configs:
        [ { feature_name: "initializeColorAttachmentWithWhite" enabled: true }]
    }
]
